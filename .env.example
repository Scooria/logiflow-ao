# --- Aplicação ---
NODE_ENV=development
PORT=3000

# --- Base de dados (Passo 1: prisma/schema.prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/logiflow_ao?schema=public"

# --- EMIS (Multicaixa Referência / MCX Express) ---
# Requer acordo comercial com o banco emissor / agregador EMIS GPO — ver
# DEPLOY.md secção "EMIS/Multicaixa e RUPE" para o que está e não está
# pronto para produção nesta integração.
EMIS_API_BASE_URL="https://gpo.emis.co.ao/api/v1"
EMIS_ENTITY_ID=""
EMIS_API_KEY=""
EMIS_WEBHOOK_SECRET=""
EMIS_REFERENCE_TTL_HOURS=72

# --- RUPE / AGT ---
# Ainda NÃO implementado neste backend — ver DEPLOY.md secção "EMIS/Multicaixa
# e RUPE" para o que é preciso (acesso ao webservice da AGT, via a Direcção
# Nacional de Tecnologias de Informação ou um integrador certificado).

# --- Stripe (clientes internacionais) ---
# Auto-serviço, sem acordo comercial: cria uma conta em
# https://dashboard.stripe.com e usa a chave de TESTE (sk_test_...) — o
# Stripe fornece cartões fictícios que nunca cobram dinheiro real.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SUCCESS_URL="https://example.com/pagamentos/sucesso"
STRIPE_CANCEL_URL="https://example.com/pagamentos/cancelado"

# --- Motor de rotas ---
# "true" permite estimar distância/tempo por um grafo de referência quando o
# tenant ainda não configurou RoadRoute reais entre duas províncias.
ALLOW_SEED_ROUTE_FALLBACK=true

# --- Document AI / Copilot (Passo 4) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
ANTHROPIC_MAX_TOKENS=4096
COPILOT_MAX_TOOL_ITERATIONS=6
